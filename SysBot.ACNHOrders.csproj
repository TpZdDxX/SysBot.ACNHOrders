<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Keeps stack trace line numbers without shipping .pdb files -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**;SysBot.Base\**" />
    <EmbeddedResource Remove="Tests\**;SysBot.Base\**" />
    <None Remove="Tests\**;SysBot.Base\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\InternalHexList.txt" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\InternalHexList.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.20.2" />
    <PackageReference Include="Discord.Net.Core" Version="3.20.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="TwitchLib.Client" Version="4.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="NHSE.Core">
      <HintPath>deps\NHSE.Core.dll</HintPath>
    </Reference>
    <Reference Include="NHSE.Villagers">
      <HintPath>deps\NHSE.Villagers.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="SysBot.Base\SysBot.Base.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Bot\Injection\" />
  </ItemGroup>

  <!-- SkiaSharp ships its native debug symbols (~96 MB) as a runtime asset, nobody running the bot needs them -->
  <Target Name="RemoveNativeSymbols" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(Extension)' == '.pdb'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
